# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://lawyers_diary_user:changeme@localhost:5432/lawyers_diary

# Generate a strong random value, e.g.: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of origins allowed to call this API (your Streamlit frontend URL(s))
CORS_ALLOW_ORIGINS=http://localhost:8501
